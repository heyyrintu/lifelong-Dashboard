# ============================================
# Lifelong Dashboard - Docker Environment Variables
# Copy this file to .env and update the values
# ============================================

# ============================================
# Database Configuration
# ============================================
# For local Docker Compose deployment (uses internal postgres service)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lifelong_dashboard?schema=public

# For external database (DigitalOcean, AWS RDS, etc.)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Postgres container settings (only needed if using local postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lifelong_dashboard

# ============================================
# Backend Configuration
# ============================================
NODE_ENV=production
BACKEND_PORT=3001
TZ=Asia/Kolkata

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# File uploads
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3000

# API URL - for browser requests
# Use localhost for external access, or 'backend' for internal container networking
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ============================================
# Appwrite Configuration
# ============================================
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=lifelong-dashboard

# Backend Appwrite settings
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key

# ============================================
# Auth0 Configuration (if using Auth0)
# ============================================
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=your-long-random-secret-at-least-32-characters
APP_BASE_URL=http://localhost:3000
