generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model attendances {
  id             String           @id
  employee_id    String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  in_time        DateTime?
  out_time       DateTime?
  total_hours    Float            @default(0)
  overtime_hours Float            @default(0)
  remarks        String?
  source         String           @default("manual")
  upload_batch   String?
  created_at     DateTime         @default(now())
  updated_at     DateTime
  employees      employees        @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, date])
  @@index([date])
  @@index([employee_id, date])
  @@index([source])
  @@index([status])
  @@index([upload_batch])
}

model billing_line_items {
  id                String          @id
  billing_period_id String
  type              String
  label             String
  qty               Float?          @default(0)
  cbm               Float?          @default(0)
  rate              Float?          @default(0)
  amount            Float           @default(0)
  is_core           Boolean         @default(false)
  source            String          @default("SYSTEM")
  created_at        DateTime        @default(now())
  updated_at        DateTime
  billing_periods   billing_periods @relation(fields: [billing_period_id], references: [id], onDelete: Cascade)

  @@index([billing_period_id])
}

model billing_periods {
  id                 String               @id
  customer_name      String
  location           String
  year               Int
  month              Int
  from_date          DateTime?
  to_date            DateTime?
  inventory_cbm      Float                @default(0)
  outbound_cbm       Float                @default(0)
  inventory_rate     Float                @default(410)
  outbound_rate      Float                @default(86)
  inventory_amount   Float                @default(0)
  outbound_amount    Float                @default(0)
  subtotal_amount    Float                @default(0)
  gst_percent        Float                @default(18)
  gst_amount         Float                @default(0)
  grand_total        Float                @default(0)
  status             String               @default("draft")
  notes              String?
  created_at         DateTime             @default(now())
  updated_at         DateTime
  billing_line_items billing_line_items[]

  @@unique([customer_name, location, year, month])
}

model employees {
  id              String        @id
  employee_id     String        @unique
  name            String
  designation     String?
  department      String?
  vendor          String?
  contact         String?
  date_of_joining DateTime?
  employee_type   EmployeeType  @default(OFF_ROLL)
  location        String        @default("Farukh Nagar")
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now())
  updated_at      DateTime
  attendances     attendances[]

  @@index([employee_type])
  @@index([is_active])
  @@index([location])
  @@index([vendor])
}

model inbound_rows {
  id               String          @id
  upload_id        String
  date_of_unload   DateTime?
  invoice_sku      String?
  received_sku     String?
  invoice_qty      Float           @default(0)
  received_qty     Float           @default(0)
  good_qty         Float           @default(0)
  item_group       String?
  cbm_per_unit     Float           @default(0)
  total_cbm        Float           @default(0)
  created_at       DateTime        @default(now())
  product_category ProductCategory @default(OTHERS)
  inbound_uploads  inbound_uploads @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@index([date_of_unload])
  @@index([item_group])
  @@index([product_category])
  @@index([upload_id, date_of_unload])
  @@index([upload_id])
}

model inbound_uploads {
  id           String         @id
  file_name    String
  uploaded_at  DateTime       @default(now())
  status       String         @default("processed")
  source       String         @default("manual-upload")
  inbound_rows inbound_rows[]
}

model inventory_daily_stock {
  id               String         @id
  inventory_row_id String
  stock_date       DateTime
  quantity         Float          @default(0)
  created_at       DateTime       @default(now())
  inventory_rows   inventory_rows @relation(fields: [inventory_row_id], references: [id], onDelete: Cascade)

  @@index([inventory_row_id])
  @@index([inventory_row_id, stock_date])
  @@index([stock_date])
  @@index([stock_date, inventory_row_id])
}

model inventory_rows {
  id                    String                  @id
  upload_id             String
  item                  String
  warehouse             String
  item_group            String
  cbm_per_unit          Float                   @default(0)
  is_total_row          Boolean                 @default(false)
  created_at            DateTime                @default(now())
  product_category      ProductCategory         @default(OTHERS)
  inventory_daily_stock inventory_daily_stock[]
  inventory_uploads     inventory_uploads       @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@index([item_group])
  @@index([product_category])
  @@index([upload_id])
  @@index([upload_id, is_total_row])
  @@index([upload_id, item_group])
  @@index([upload_id, product_category])
}

model inventory_uploads {
  id             String           @id
  file_name      String
  uploaded_at    DateTime         @default(now())
  status         String           @default("processing")
  source         String           @default("manual-upload")
  inventory_rows inventory_rows[]
}

model item_master {
  id           String   @id
  item_group   String
  cbm_per_unit Float    @default(0)
  created_at   DateTime @default(now())
}

model outbound_rows {
  id                  String             @id
  upload_id           String
  customer_group      String?
  source_warehouse    String?
  so_item             String?
  category_raw        String?
  sales_order_qty     Float              @default(0)
  so_total_cbm        Float              @default(0)
  delivery_note_date  DateTime?
  delivery_note_item  String?
  delivery_note_qty   Float              @default(0)
  dn_total_cbm        Float              @default(0)
  transporter         String?
  normalized_category NormalizedCategory
  product_category    ProductCategory    @default(OTHERS)
  created_at          DateTime           @default(now())
  so_date             DateTime?
  dispatch_by_date    DateTime?
  outbound_uploads    outbound_uploads   @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@index([delivery_note_date])
  @@index([dispatch_by_date])
  @@index([normalized_category])
  @@index([product_category])
  @@index([so_date])
  @@index([upload_id, delivery_note_date])
  @@index([upload_id])
  @@index([upload_id, normalized_category])
  @@index([upload_id, so_date])
}

model outbound_uploads {
  id            String          @id
  file_name     String
  uploaded_at   DateTime        @default(now())
  status        String          @default("processed")
  source        String          @default("manual-upload")
  outbound_rows outbound_rows[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  WEEKLY_OFF
  HALF_DAY
}

enum EmployeeType {
  ON_ROLL
  OFF_ROLL
}

enum NormalizedCategory {
  E_COMMERCE
  OFFLINE
  QUICK_COMMERCE
  EBO
  B2C
  OTHERS
}

enum ProductCategory {
  EDEL
  HOME_AND_KITCHEN
  ELECTRONICS
  HEALTH_AND_PERSONAL_CARE
  AUTOMOTIVE_AND_TOOLS
  TOYS_AND_GAMES
  BRAND_PRIVATE_LABEL
  OTHERS
}
