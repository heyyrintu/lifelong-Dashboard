# Database
DATABASE_URL="postgresql://user:password@localhost:5432/drona_dashboard"

# Server
PORT=3001
NODE_ENV=production

# Timezone - CRITICAL for date filtering to work correctly
# Must match the server's timezone. Use Asia/Kolkata for IST
TZ=Asia/Kolkata

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Authentication (uncomment when auth is enabled)
# JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
# JWT_EXPIRES_IN=24h

# Appwrite Configuration
# Backend uses these for server-side auth validation
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id

# Appwrite Server API Key - REQUIRED to bypass rate limits!
# Create at: Appwrite Console → Your Project → Settings → API Keys
# Scopes needed: account (for user validation)
# This key bypasses Appwrite's per-IP rate limits for server-side requests
APPWRITE_API_KEY=your-appwrite-api-key-here

# Frontend Appwrite config (also used as fallback)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=your-project-name
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# File Upload
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads
